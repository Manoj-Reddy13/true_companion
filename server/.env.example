# True Companion Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# If local MongoDB is not running, the application automatically uses the embedded persistent store!
MONGODB_URI=mongodb://127.0.0.1:27017/true_companion

# JWT Secret Key
JWT_SECRET=true_companion_secure_jwt_secret_token_change_in_production_2026

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary / Supabase Storage (for remote production storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
